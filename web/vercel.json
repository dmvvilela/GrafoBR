{
  "framework": null,
  "installCommand": "echo 'Redirect only'",
  "buildCommand": "mkdir -p redirect-output && printf \"GrafoBR moved to Cloudflare\" > redirect-output/index.html",
  "outputDirectory": "redirect-output",
  "redirects": [
    {
      "source": "/",
      "destination": "https://grafo-br.dmvvilela.workers.dev/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "destination": "https://grafo-br.dmvvilela.workers.dev/:path*",
      "statusCode": 301
    }
  ]
}
